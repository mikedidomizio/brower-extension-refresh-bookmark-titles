{
  "manifest_version": 3,
  "name": "Refresh Bookmarks",
  "version": "1.0.0",
  "description": "Automatically update bookmarks with empty titles by fetching page titles",
  "permissions": ["bookmarks", "activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Refresh Bookmarks"
  }
}
